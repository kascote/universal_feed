<!--
Description: two podcast:publisher tags at channel level (last tag wins)
Expect:      publisher.remoteItem.feedGuid=='second-tag-guid'
-->
<rss xmlns:podcast="https://podcastindex.org/namespace/1.0">
<channel>
<podcast:publisher>
  <podcast:remoteItem medium="publisher" feedGuid="first-tag-guid" />
</podcast:publisher>
<podcast:publisher>
  <podcast:remoteItem medium="publisher" feedGuid="second-tag-guid" />
</podcast:publisher>
</channel>
</rss>
